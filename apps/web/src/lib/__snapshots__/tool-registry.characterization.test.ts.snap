  {
    "availableIn": "room",
    "category": "secrets",
    "description": "Create a skeleton External Secret in ORION backed by Vault. Writes PLACEHOLDER values to Vault so the human can fill in the real values inside ORION (Infrastructure > External Secrets > pencil icon). Use this when asked to scaffold, create, or set up a secret for a deployment.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "description": {
          "description": "What this secret is for and who uses it (optional)",
          "type": "string",
        },
        "environmentName": {
          "description": "Name of the ORION environment to create the secret in.",
          "type": "string",
        },
        "keyNames": {
          "description": "List of secret key names to scaffold (e.g. ["DB_PASSWORD", "DB_USER"]). PLACEHOLDER values will be written to Vault.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "name": {
          "description": "Human-readable label for the ExternalSecret (e.g. "gitea-db-secret")",
          "type": "string",
        },
        "namespace": {
          "description": "Kubernetes namespace where the Secret will live (default: "default")",
          "type": "string",
        },
        "refreshInterval": {
          "description": "ESO sync interval, e.g. "1h", "15m" (default: "1h")",
          "type": "string",
        },
        "targetSecretName": {
          "description": "K8s Secret name (defaults to the ExternalSecret name)",
          "type": "string",
        },
        "vaultPath": {
          "description": "Vault KV v2 path relative to the "secret" mount (e.g. "gitea/db"). No "secret/data/" prefix.",
          "type": "string",
        },
      },
      "required": [
        "environmentName",
        "name",
        "vaultPath",
        "keyNames",
      ],
      "type": "object",
    },
    "name": "write_secret",
    "parallelSafe": false,
    "tier": "write",
  },
