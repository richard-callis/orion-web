exports[`tool registry characterization > registers the same tools, in the same order, with the same metadata and schemas 1`] = `
[
  {
    "availableIn": "both",
    "category": "gitops",
    "description": "List files and directories in the GitOps repo for an environment. Call this BEFORE gitops_propose to check what paths already exist so you place new files consistently with the existing structure. Defaults to the environment's watched directory (e.g. "deployments/") — pass a sub-path to drill in (e.g. "deployments/tailscale").",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "environment_id": {
          "description": "Environment ID or name",
          "type": "string",
        },
        "path": {
          "description": "Directory path to list. Omit to list the watched directory root (e.g. "deployments/"). Pass a sub-path to drill in, e.g. "deployments/tailscale".",
          "type": "string",
        },
      },
      "required": [
        "environment_id",
      ],
      "type": "object",
    },
    "name": "gitops_ls",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "agents",
    "description": "List all agents on the team — their IDs, names, roles, and current busy/available status. Use this to see who is available before assigning work or creating new agents.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "include_archived": {
          "description": "Include archived agents (default false)",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "orion_list_agents",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "List tasks filtered by status, assignment, and date. Use this to find unassigned work, check what is running, or review failed tasks.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "assigned_agent_id": {
          "description": "Filter to tasks assigned to a specific agent ID",
          "type": "string",
        },
        "since": {
          "description": "ISO 8601 timestamp — only return tasks created or updated after this date. Use this to fetch only new work since your last review.",
          "type": "string",
        },
        "status": {
          "description": "Filter by status: pending, in_progress, pending_validation, done, failed. Defaults to pending+in_progress+failed. Use "pending_validation" to find tasks awaiting Veritas review.",
          "type": "string",
        },
        "unassigned_only": {
          "description": "Only return tasks with no agent or user assigned (default false)",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "orion_list_tasks",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Assign a pending task to an agent. Sets the task status to pending and records the agent assignment.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "agent_id": {
          "description": "Agent ID to assign the task to",
          "type": "string",
        },
        "task_id": {
          "description": "Task ID to assign",
          "type": "string",
        },
      },
      "required": [
        "task_id",
        "agent_id",
      ],
      "type": "object",
    },
    "name": "orion_assign_task",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "agents",
    "description": "Create a new agent. Use only when no existing agent is suitable for the required work.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "description": {
          "description": "Optional longer description",
          "type": "string",
        },
        "llm": {
          "description": "LLM to use (e.g. ext:<id>). Omit to use the system default.",
          "type": "string",
        },
        "name": {
          "description": "Unique agent name (cannot be a reserved name: human, user, system, admin)",
          "type": "string",
        },
        "persistent": {
          "description": "true = persistent agent that stays in the roster; false = transient, will be archived when its work is done (default: false)",
          "type": "boolean",
        },
        "role": {
          "description": "One-line role description",
          "type": "string",
        },
        "systemPrompt": {
          "description": "REQUIRED — full system prompt defining the agent's personality, responsibilities, and operating rules. Must be specific and actionable.",
          "type": "string",
        },
        "type": {
          "description": "Agent type for AI agents (default: claude). Do NOT use "human" — that is reserved for human users.",
          "type": "string",
        },
      },
      "required": [
        "name",
        "role",
        "systemPrompt",
      ],
      "type": "object",
    },
    "name": "orion_create_agent",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "agents",
    "description": "Update an existing agent's role, description, system prompt, LLM, or review timestamp. Use this to improve agents based on observed performance — sharpen their prompts, fix their role description, or reassign their LLM. Also call this with mentorReviewedAt to record that you have reviewed an agent even if no prompt change was needed.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "agent_id": {
          "description": "Agent ID to update",
          "type": "string",
        },
        "description": {
          "description": "Updated longer description",
          "type": "string",
        },
        "llm": {
          "description": "Updated LLM (e.g. ext:<id>)",
          "type": "string",
        },
        "mentorReviewedAt": {
          "description": "ISO 8601 timestamp to record when Mentor last reviewed this agent. Always set this after completing a review, even if no changes were made.",
          "type": "string",
        },
        "role": {
          "description": "Updated one-line role description",
          "type": "string",
        },
        "systemPrompt": {
          "description": "Updated full system prompt",
          "type": "string",
        },
      },
      "required": [
        "agent_id",
      ],
      "type": "object",
    },
    "name": "orion_update_agent",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "agents",
    "description": "Soft-archive a transient agent after its work is done. Never deletes — preserves audit trail (SOC2 [A-001]).",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "agent_id": {
          "description": "Agent ID to archive",
          "type": "string",
        },
        "reason": {
          "description": "Optional reason for archiving",
          "type": "string",
        },
      },
      "required": [
        "agent_id",
      ],
      "type": "object",
    },
    "name": "orion_archive_agent",
    "parallelSafe": false,
    "tier": "destructive",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Escalate a task to a human user. Sets the assignedUserId and status to pending.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "task_id": {
          "description": "Task ID to escalate",
          "type": "string",
        },
        "user_id": {
          "description": "User ID to assign the task to",
          "type": "string",
        },
      },
      "required": [
        "task_id",
        "user_id",
      ],
      "type": "object",
    },
    "name": "orion_escalate_task",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Fetch the execution event log for a task. Returns timestamped events including tool calls, tool results, and agent output. Use this to verify whether a task was actually executed before closing it.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "limit": {
          "description": "Maximum number of events to return (default 50)",
          "type": "number",
        },
        "task_id": {
          "description": "Task ID to fetch events for",
          "type": "string",
        },
      },
      "required": [
        "task_id",
      ],
      "type": "object",
    },
    "name": "orion_get_task_events",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Mark a task as done after confirming the work was actually completed. Only works on tasks in pending_validation status. ONLY call this after verifying via orion_get_task_events that real tool calls were made and the outcome matches the task description.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "summary": {
          "description": "Brief validation summary — what was confirmed and how",
          "type": "string",
        },
        "task_id": {
          "description": "Task ID to close",
          "type": "string",
        },
      },
      "required": [
        "task_id",
        "summary",
      ],
      "type": "object",
    },
    "name": "orion_close_task",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Reopen a pending_validation task back to pending. Use when validation reveals the task was not actually completed — e.g. agent self-reported done with zero tool calls.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "reason": {
          "description": "Why the task is being reopened",
          "type": "string",
        },
        "task_id": {
          "description": "Task ID to reopen",
          "type": "string",
        },
      },
      "required": [
        "task_id",
        "reason",
      ],
      "type": "object",
    },
    "name": "orion_reopen_task",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "rooms",
    "description": "List chat rooms. Optionally filter by feature_id to find the coordination room for a feature.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "feature_id": {
          "description": "Filter by feature ID to find the feature coordination room",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "orion_list_rooms",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "rooms",
    "description": "Post a message to a chat room. Use this to communicate with other agents or report status in a feature coordination room.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "content": {
          "description": "Message content to post",
          "type": "string",
        },
        "room_id": {
          "description": "Chat room ID to post the message to",
          "type": "string",
        },
      },
      "required": [
        "room_id",
        "content",
      ],
      "type": "object",
    },
    "name": "orion_send_message",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "rooms",
    "description": "Set an active goal for a chat room. While a goal is active, agents in the room must respond with progress rather than going silent. Use this when you want an agent to keep working until a task is explicitly done.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "goal": {
          "description": "Clear description of what must be accomplished",
          "type": "string",
        },
        "room_id": {
          "description": "Chat room ID to set the goal in",
          "type": "string",
        },
      },
      "required": [
        "room_id",
        "goal",
      ],
      "type": "object",
    },
    "name": "orion_set_goal",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "rooms",
    "description": "Mark the active goal in a chat room as complete and clear it. GUARD: Only call this after you have VERIFIED the goal is actually done — check pod status, test endpoints, confirm resources are healthy. Do NOT call this just because a PR was merged, a command was issued, or you believe the work should be done. You must have observed real evidence of success (e.g. kubectl_get_pods showing Running, HTTP 200 from the endpoint). Provide a verification_summary describing exactly what you checked.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "room_id": {
          "description": "Chat room ID to clear the goal from",
          "type": "string",
        },
        "verification_summary": {
          "description": "What you actually checked to confirm the goal is complete. E.g. "kubectl_get_pods shows all 7 arr-stack pods Running; curl sonarr.example.com returns 200". Required — vague answers will be rejected.",
          "type": "string",
        },
      },
      "required": [
        "room_id",
        "verification_summary",
      ],
      "type": "object",
    },
    "name": "orion_complete_goal",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "features",
    "description": "Create a new feature under an epic. GUARD: will fail if epic.plan is null — the epic must have a saved plan before features can be created.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "description": {
          "description": "Feature description (optional)",
          "type": "string",
        },
        "epicId": {
          "description": "ID of the parent epic",
          "type": "string",
        },
        "title": {
          "description": "Feature title",
          "type": "string",
        },
      },
      "required": [
        "epicId",
        "title",
      ],
      "type": "object",
    },
    "name": "orion_create_feature",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "tasks",
    "description": "Create a new task under a feature with a step-by-step implementation plan. The plan should be numbered steps specific enough for a smaller LLM to execute without additional context. GUARD: will fail if feature.plan is null.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "dedup_key": {
          "description": "Optional deduplication key. If an open task (pending/in_progress/pending_validation) with this exact key already exists under the same feature, creation is skipped and the existing task is returned. Use a stable identifier like "pulse:host:vault-proxy" or "pulse:node:talos-rpi2".",
          "type": "string",
        },
        "depends_on": {
          "description": "Optional list of Task IDs that must reach status "done" before this task is allowed to run. Use the IDs returned by previous orion_create_task calls to express ordering (e.g. a deploy task that depends on a build task). Execution waves are computed from these dependencies at plan-approval time.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "description": {
          "description": "Task description (optional)",
          "type": "string",
        },
        "featureId": {
          "description": "ID of the parent feature",
          "type": "string",
        },
        "plan": {
          "description": "Numbered step-by-step implementation plan. Each step should be specific enough for a smaller LLM to execute. E.g.:
1. Read /path/to/file and understand X
2. Edit Y to add Z
3. Run the test suite
4. Verify output matches expected",
          "type": "string",
        },
        "priority": {
          "description": "Optional task priority. Defaults to "medium". Higher-priority tasks within the same execution wave run first.",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
          ],
          "type": "string",
        },
        "targetEnvironment": {
          "description": "For deployment tasks — the target environment as designated by the Atlas. Pass as an object with keys: namespace (e.g. "apps"), hostname (e.g. "myapp.example.com"), storageClass (e.g. "longhorn", if storage needed), vaultPath (e.g. "secret/data/myapp", if secrets needed), certIssuer (e.g. "letsencrypt-prod", if the Ingress is TLS-enabled — the executing agent must set this as the cert-manager.io/cluster-issuer annotation or no certificate will be issued).",
          "type": "object",
        },
        "title": {
          "description": "Task title",
          "type": "string",
        },
      },
      "required": [
        "featureId",
        "title",
        "plan",
      ],
      "type": "object",
    },
    "name": "orion_create_task",
    "parallelSafe": false,
    "tier": "write",
  },
  {
    "availableIn": "both",
    "category": "gitops",
    "description": "List all API resources available in the cluster — built-in Kubernetes resource types plus all installed CRDs. Use this before writing manifests to verify that the apiVersions and kinds you plan to use actually exist. Prevents ArgoCD sync failures caused by referencing non-existent CRDs.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {},
      "required": [],
      "type": "object",
    },
    "name": "get_cluster_api_resources",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "gitops",
    "description": "Validate Kubernetes manifest files against the cluster's actual API resources. Checks each document's apiVersion/kind against built-in Kubernetes resources and installed CRDs. Returns a pass/fail report. Call this before gitops_propose whenever manifests use non-standard apiVersions.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "files": {
          "description": "Array of manifest files to validate.",
          "items": {
            "properties": {
              "content": {
                "description": "Full YAML content of the file",
                "type": "string",
              },
              "path": {
                "description": "File path (for display in the report)",
                "type": "string",
              },
            },
            "required": [
              "path",
              "content",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "files",
      ],
      "type": "object",
    },
    "name": "validate_manifest",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "environment",
    "description": "Comprehensive health check across all ORION-managed systems: (1) all enabled IngressRoutes — HTTP reachability and SSL cert validity; (2) Kubernetes cluster node readiness and pod issues (CrashLoopBackOff, OOMKilled, Failed, Pending); (3) all registered environment gateways; (4) ORION system services (Gitea, Vault, ORION itself). Each degraded item includes a canonical taskKey field — pass this as dedup_key when calling orion_create_task to prevent duplicate fix tasks.",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "namespace": {
          "description": "Limit check to a specific namespace (optional — omit to check all namespaces)",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "orion_cluster_health",
    "parallelSafe": true,
    "tier": "read",
  },
  {
    "availableIn": "both",
    "category": "tools",
    "description": "Request explicit authorization to call a destructive-tier tool. Creates an approval request that a human admin must review in the ORION UI (Administration → Approvals). Once approved, a one-time grant is created and the next call to the tool will succeed. Use this when a tool call was denied with "destructive tool requires explicit authorization".",
    "hasHandler": true,
    "inputSchema": {
      "properties": {
        "reason": {
          "description": "Why this destructive tool is needed for the current task — be specific",
          "type": "string",
        },
        "tool_name": {
          "description": "Exact name of the destructive tool being requested (e.g. "orion_archive_agent")",
          "type": "string",
        },
      },
      "required": [
