# Rendered by lib/bootstrap/monitoring.ts: __INTERNAL_DOMAIN__ is replaced with
# the internal domain configured in ORION (Ingress → Domains). Skipped if none.
# IngressRoute for Elastiflow web UI
apiVersion: traefik.containo.us/v1alpha1
kind: IngressRoute
metadata:
  name: elastiflow
  namespace: monitoring
  labels:
    app: elastiflow
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`netflow.__INTERNAL_DOMAIN__`)
      kind: Rule
      services:
        - name: elastiflow
          port: 8080
          namespace: monitoring
