{
  "name": "orion",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/gateway",
    "apps/executor"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:gateway": "npm run dev --workspace=apps/gateway",
    "dev:executor": "npm run dev --workspace=apps/executor",
    "build:web": "npm run build --workspace=apps/web",
    "build:gateway": "npm run build --workspace=apps/gateway",
    "build:executor": "npm run build --workspace=apps/executor",
    "lint": "eslint apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/gateway && tsc --noEmit -p apps/executor",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.26",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1"
  }
}
